# Gemini API
GEMINI_API_KEY=your_gemini_api_key

# LƯU Ý: Đã bỏ Vertex AI Vector Search và chuyển sang dùng 100% Gemini 1.5 Flash 
# để tiết kiệm chi phí và tăng tốc độ setup cho Hackathon.

# Gemini Live API (ECHO-22)
GEMINI_LIVE_MODEL=gemini-3.8-live
GEMINI_LIVE_VOICE=Puck

# Lockdown / audit trail (ECHO-25)
# Set to write incident_logs to Cloud Firestore; unset keeps them in memory only.
GOOGLE_CLOUD_PROJECT=
# Manual risk trigger (stand-in for the Supervisor Agent). Leave off in production.
ECHO_ENABLE_RISK_TRIGGER=0
ECHO_INTERNAL_KEY=change-me
