# ========================================================
# ECHO BACKEND ENVIRONMENT CONFIGURATION
# ========================================================

# --------------------------------------------------------
# 1. Google Gemini AI Engine (MANDATORY)
# Get your API key at: https://aistudio.google.com/
# --------------------------------------------------------
GEMINI_API_KEY=your_gemini_api_key_here

# Semantic analysis model for Coercion Intent & DoA Compliance
GEMINI_MODEL=gemini-3.5-flash-lite

# Real-time multimodal streaming model for Acoustic Watch Agent
GEMINI_LIVE_MODEL=gemini-3.8-live
GEMINI_LIVE_VOICE=Puck

# --------------------------------------------------------
# 2. Voice Warning & Speech Synthesis Engine (OPTIONAL)
# Tier 1 Speech Engine: https://elevenlabs.io/
# --------------------------------------------------------
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here

# --------------------------------------------------------
# 3. Server & Networking Settings
# --------------------------------------------------------
ENVIRONMENT=production
PORT=8000

# Comma-separated list of allowed CORS origins (leave empty to allow Cloud Run *.run.app + localhost)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:3001,http://127.0.0.1:3001

# --------------------------------------------------------
# 4. Latency SLAs & High-Frequency Streaming Tuning (Seconds)
# --------------------------------------------------------
SLA_TIMEOUT_SUPERVISOR=0.75
SLA_TIMEOUT=0.70

# --------------------------------------------------------
# 5. Google Cloud Platform / Vertex AI (Optional)
# --------------------------------------------------------
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
GOOGLE_CLOUD_LOCATION=asia-southeast1
GCS_BUCKET_NAME=echo-audit-logs
