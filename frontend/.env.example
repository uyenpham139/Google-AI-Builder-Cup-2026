# ========================================================
# ECHO FRONTEND (CORPORATE TREASURY PORTAL)
# ========================================================

# HTTP URL of the Echo FastAPI Backend (local or Cloud Run)
NEXT_PUBLIC_API_URL=http://localhost:8000

# WebSocket URL for real-time CAEP RFC 9493 screen lock signals
NEXT_PUBLIC_WS_URL=ws://localhost:8000

# Server Port (default 3000 locally, overridden dynamically by Cloud Run)
PORT=3000
NODE_ENV=production
