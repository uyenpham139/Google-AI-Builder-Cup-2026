# ========================================================
# ECHO - ROOT MONOREPO & DOCKER COMPOSE CONFIGURATION
# Copy this file to .env to run with Docker Compose:
# cp .env.example .env
# ========================================================

# --------------------------------------------------------
# 1. Google Gemini AI Engine (Required for Backend)
# Obtain key at: https://aistudio.google.com/
# --------------------------------------------------------
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_LIVE_MODEL=gemini-3.8-live
GEMINI_LIVE_VOICE=Puck

# --------------------------------------------------------
# 2. ElevenLabs Speech Engine (Optional for Voice Barge-in)
# Obtain key at: https://elevenlabs.io/
# --------------------------------------------------------
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=pNInz6obpgDQGcFmaJgB

# --------------------------------------------------------
# 3. Google Cloud Platform Deployment (For Cloud Run & CI/CD)
# --------------------------------------------------------
GCP_PROJECT_ID=your-gcp-project-id
GCP_REGION=asia-southeast1
GAR_REPOSITORY=echo-repo

# --------------------------------------------------------
# 4. Service Host & Port Mappings (Docker Compose defaults)
# --------------------------------------------------------
BACKEND_PORT=8000
FRONTEND_PORT=3000
CALL_PORT=3001
